    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.lingxi</groupId>
        <artifactId>lingxi</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>lingxi-server</artifactId>
    <name>lingxi-server</name>
    <description>Phase-1 modular monolith bootstrap</description>

    <dependencies>
