# ============================================================
# 灵犀系统 · WorkBuddy-Cursor 混合流水线 · 环境变量模板
# ============================================================
# 使用方法：复制本文件为 .env，填入真实值
#   cp .env.example .env
# 然后用 source .env 加载到当前 shell 会话
#   source .env
# ============================================================

# Cursor API 认证密钥（Dashboard 生成，按量计费）
# 获取地址：https://cursor.com/dashboard → API Keys
CURSOR_API_KEY=""

# GitHub Token（用于 git fetch / gh pr view / gh pr merge）
# 获取地址：https://github.com/settings/tokens (Classic, 勾选 repo 权限)
GITHUB_TOKEN=""

# 仓库地址（派发任务时 Agent clone 的仓库）
REPO_URL="https://github.com/Welch-Qi/LingXi.git"

# 基线分支（Agent 从此分支创建工作分支）
BASE_BRANCH="main"

# 分支前缀（Agent 产出分支的前缀）
BRANCH_PREFIX="cursor/feat"

# Cloud Agents API 基础 URL
CURSOR_API_BASE="https://api.cursor.com/v1"

# 轮询间隔（秒），默认 15 分钟 = 900 秒
POLL_INTERVAL=900

# 单次 run 超时（秒），默认 90 分钟 = 5400 秒
RUN_TIMEOUT=5400

# 修复轮次上限
MAX_FIX_ROUNDS=5
